{
  "name": "telegram-desktop-web",
  "version": "1.0.0",
  "description": "Telegram Web K as native desktop app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win dir",
    "dev": "node dev.js",
    "start:dev": "node dev.js",
    "start:profile": "electron . --profile=dev",
    "test": "node --test server.test.js liveReload.test.js",
    "test:electron": "node verifyLiveReload.js"
  },
  "keywords": [],
  "author": "me",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  },
  "productName": "TelegramAll",
  "build": {
    "appId": "org.telegram.webk.desktop",
    "productName": "TelegramAll",
    "icon": "build/icon.png",
    "files": [
      "main.js",
      "server.js",
      "liveReload.js",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "../tweb/public",
        "to": "dist",
        "filter": [
          "assets/**/*",
          "changelogs/**/*",
          "decoderWorker.min.wasm",
          "encoderWorker.min.wasm",
          "site.webmanifest",
          "site_apple.webmanifest",
          "browserconfig.xml",
          "version"
        ]
      },
      {
        "from": "../tweb/dist",
        "to": "dist",
        "filter": [
          "**/*",
          "!**/*.map"
        ]
      }
    ],
    "win": {
      "target": "dir",
      "icon": "build/icon.png"
    },
    "directories": {
      "output": "release"
    }
  }
}
